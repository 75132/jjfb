# Juben storage server (port 8787)
PORT=8787
DATA_DIR=./data

# DeepSeek AI（可选；未配置时 AI 助手返回 503）
# 在 https://platform.deepseek.com/api_keys 创建密钥后填入下一行
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 官方 OpenAI 兼容：https://api.deepseek.com/chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek-V4.1-Flash 官方模型名（也可用 deepseek-v4.1flash 等别名，会归一化）
DEEPSEEK_MODEL=deepseek-flash
# 默认关闭 thinking，避免长推理卡死；需要时改为 enabled
DEEPSEEK_THINKING=disabled
DEEPSEEK_TEMPERATURE=0.9
DEEPSEEK_MAX_TOKENS=8192
