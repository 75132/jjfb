    "dialogueScripts": {
      "dlg_100001_intro": {
        "speaker": "韩诺中尉",
        "lines": [
          "抬头看天，红警不是演习。虫族已经咬到外环了。",
          "最后问一遍，你是自愿来的，还是被热血冲昏了头？"
        ]
      },
      "dlg_100002_doctor": {
        "speaker": "凯尔博士",
        "lines": [
          "不许停！样本舱里是防线的命，不是我的命！",
          "它们冲我来的……该死，来得比预计快太多了！"
        ]
      },
      "dlg_100004_hangar": {
        "speaker": "维塔",
        "lines": [
          "机体没问题，问题通常出在驾驶员。把手放上去，做神经同步。",
          "疼是正常的，说明你和机甲在认识彼此。"
        ]
      },
      "dlg_100005_final": {
        "speaker": "罗威教官",
        "lines": [
          "结业考核没有第二次。要么过关，要么躺着下场。",
          "目标是一只强化虫族精英，弱点在外甲裂缝，自己找。"
        ]
      }
    },
    "choiceScripts": {
      "choice_join_team": {
        "title": "是否确认加入机甲战斗队？",
        "options": [
          {
            "id": "yes",
            "text": "是，我签字，立刻报到",
            "npcReply": "行，名字我记下了。从现在起，你归我带。跟紧，别死在报到路上。"
          },
          {
            "id": "no",
            "text": "否，我想退出",
            "npcReply": "现在后退，我也不拦你。只是下一次警报响起，未必还有人替你挡。",
            "systemTip": "你尚未确认参战，主线无法推进。"
          }
        ]
      },
      "choice_doctor_ambush": {
        "title": "博士车队遭袭，是否立即出战？",
        "options": [
          {
            "id": "fight",
            "text": "迎战！我来护送博士",
            "npcReply": "右侧废墟有动静！新兵，上前，护住博士车！"
          },
          {
            "id": "retreat",
            "text": "请求后撤重整",
            "npcReply": "后撤？你一退，博士就得死。命令：立刻迎敌！",
            "forcedResult": "start_battle"
          }
        ]
      },
      "choice_calibration_mode": {
        "title": "请选择校准倾向",
        "options": [
          {
            "id": "atk",
            "text": "火力优先（更快击杀）",
            "systemTip": "本场获得输出倾向增益。"
          },
          {
            "id": "def",
            "text": "生存优先（更高容错）",
            "systemTip": "本场获得防御倾向增益。"
          }
        ]
      },
      "choice_graduation_battle": {
        "title": "是否开始结业实战？",
        "options": [
          {
            "id": "start",
            "text": "开始，我准备好了",
            "npcReply": "别上头，先拆外甲，再压核心。"
          },
          {
            "id": "later",
            "text": "再给我一点准备时间",
            "systemTip": "你选择暂缓挑战。可与罗威教官再次对话后开战。"
          }
        ]
      },
      "choice_to_faxi": {
        "title": "是否立即前往法西城？",
        "options": [
          {
            "id": "go",
            "text": "是，立刻出发",
            "npcReply": "好，法西城见。别让今天的勇气只停在今天。"
          },
          {
            "id": "stay",
            "text": "否，我再整理装备",
            "systemTip": "你暂缓出发。可随时与韩诺中尉对话进行传送。"
          }
        ]
      }
    }
  },
