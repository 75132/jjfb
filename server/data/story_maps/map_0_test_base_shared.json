    "dialogueScripts": {
      "dlg_100001_intro": {
        "speaker": "韩诺中尉",
        "lines": [
          "抬头看天，红警不是演习。虫族已经咬到外环了。",
          "最后问一遍，你是自愿来的，还是被热血冲昏了头？"
        ]
      },
      "dlg_100002_doctor": {
        "speaker": "凯尔博士",
        "lines": [
          "不许停！样本舱里是防线的命，不是我的命！",
          "它们冲我来的……该死，来得比预计快太多了！"
        ]
      },
      "dlg_100004_hangar": {
        "speaker": "维塔",
        "lines": [
          "机体没问题，问题通常出在驾驶员。把手放上去，做神经同步。",
          "疼是正常的，说明你和机甲在认识彼此。"
        ]
      },
      "dlg_100005_final": {
        "speaker": "罗威教官",
        "lines": [
          "结业考核没有第二次。要么过关，要么躺着下场。",
          "目标是一只强化虫族精英，弱点在外甲裂缝，自己找。"
        ]
      },
      "dlg_100003_outpost_intro": {
        "speaker": "韩诺中尉（通讯）",
        "lines": [
          "地底热源在跳，掘地虫在找防线薄点。",
          "我压右线，你守左线。记住，漏一只，后面就是民用区。"
        ]
      },
      "dlg_100006_pre_faxi": {
        "speaker": "韩诺中尉",
        "lines": [
          "你的档案已经上传法西城指挥部，身份从「志愿者」改为「战斗员」。",
          "今天你护住了一个博士，明天你要护住一座城。",
          "门在你面前，路也在你面前。选吧。"
        ]
      }
    },
    "choiceScripts": {
      "choice_join_team": {
        "title": "是否确认加入机甲战斗队？",
        "options": [
          {
            "id": "yes",
            "text": "是，我签字，立刻报到",
            "npcReply": "行，名字我记下了。从现在起，你归我带。跟紧，别死在报到路上。"
          },
          {
            "id": "no",
            "text": "否，我想退出",
            "npcReply": "现在后退，我也不拦你。只是下一次警报响起，未必还有人替你挡。",
            "systemTip": "你尚未确认参战，主线无法推进。"
          }
        ]
      },
      "choice_doctor_ambush": {
        "title": "博士车队遭袭，是否立即出战？",
        "options": [
          {
            "id": "fight",
            "text": "迎战！我来护送博士",
            "npcReply": "右侧废墟有动静！新兵，上前，护住博士车！",
            "systemTip": "[战斗 300001] 模拟胜利"
          },
          {
            "id": "retreat",
            "text": "请求后撤重整",
            "npcReply": "后撤？你一退，博士就得死。命令：立刻迎敌！",
            "forcedResult": "start_battle",
            "systemTip": "[战斗 300001] 模拟胜利"
          }
        ]
      },
      "choice_outpost_method": {
        "title": "请选择作战方式",
        "options": [
          {
            "id": "rush",
            "text": "正面突击，先打断虫群推进",
            "npcReply": "好，高风险突击，火力压制拉满。别恋战，打完就撤。",
            "systemTip": "[战斗 300002] 高风险突击：火力压制·胜利"
          },
          {
            "id": "steady",
            "text": "稳步推进，优先保护防线完整",
            "npcReply": "行，稳健推进。防线完整比人头数更重要。",
            "systemTip": "[战斗 300002] 稳健推进：防线保全·胜利"
          }
        ]
      },
      "choice_calibration_mode": {
        "title": "请选择校准倾向",
        "options": [
          {
            "id": "atk",
            "text": "火力优先（更快击杀）",
            "systemTip": "本场获得输出倾向增益。（[战斗 300003] 模拟胜利）"
          },
          {
            "id": "def",
            "text": "生存优先（更高容错）",
            "systemTip": "本场获得防御倾向增益。（[战斗 300003] 模拟胜利）"
          }
        ]
      },
      "choice_graduation_battle": {
        "title": "是否开始结业实战？",
        "options": [
          {
            "id": "start",
            "text": "开始，我准备好了",
            "npcReply": "别上头，先拆外甲，再压核心。",
            "systemTip": "[战斗 300004] Boss战·模拟胜利"
          },
          {
            "id": "later",
            "text": "再给我一点准备时间",
            "systemTip": "你选择暂缓挑战。可与罗威教官再次对话后开战。"
          }
        ]
      },
      "choice_to_faxi": {
        "title": "是否立即前往法西城？",
        "options": [
          {
            "id": "go",
            "text": "是，立刻出发",
            "npcReply": "好，法西城见。别让今天的勇气只停在今天。"
          },
          {
            "id": "stay",
            "text": "否，我再整理装备",
            "systemTip": "你暂缓出发。可随时与韩诺中尉对话进行传送。"
          }
        ]
      }
    }
  },
