    "client": {
      "dialogueScripts": {
        "dlg_node_5a1396b9_e201_4fb1_90a6_9b27b6ce1820": {
          "speaker": "韩诺",
          "lines": [
            "欢迎来到前线阵地，新兵。我是你的引导员，韩诺。",
            "这里曾是人类与虫族交锋的最前沿，但现在我们面对的已不仅仅是虫子…",
            "上头决定让你这样的新兵也接受机甲召唤师的训练。你准备好了吗？"
          ]
        },
        "dlg_node_484787ab_9cdd_47aa_bc33_319bb91a7bd8": {
          "speaker": "韩诺",
          "lines": [
            "你在之前的训练中表现不错，但现在没时间庆祝了。",
            "前方补给站发来求救信号，有一只虫族正在破坏我们的补给物资。",
            "去补给站消灭那只该死的虫子，然后回来向我报告。"
          ]
        },
        "dlg_node_09bf0c71_8a2b_42fc_bb34_2b2e0c7ae55e": {
          "speaker": "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第2幕",
          "lines": [
            "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第2幕：有件事需要你帮忙。"
          ]
        },
        "dlg_node_9f77a86d_1696_4681_ab79_74cc1e04a8f3": {
          "speaker": "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第2幕",
          "lines": [
            "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第2幕：有件事需要你帮忙。"
          ]
        },
        "dlg_node_f0f87533_c6b1_4e78_b107_1d5b8dabeb8e": {
          "speaker": "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第2幕",
          "lines": [
            "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第2幕：敌人已在附近出现，找到并击败后再来找我交任务。"
          ]
        },
        "dlg_node_c53f5738_917f_4941_8f1b_a12f4ef89083": {
          "speaker": "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第2幕",
          "lines": [
            "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第2幕：敌人已在附近出现，找到并击败后再来找我交任务。"
          ]
        },
        "dlg_node_a5e44c83_ec74_459c_a99d_314aef7a437d": {
          "speaker": "韩诺",
          "lines": [
            "干得漂亮，补给站的危机解除了。但更糟糕的消息传来…",
            "我们的前哨站遭到了虫族的猛烈攻击，守卫部队正在苦战。",
            "现在是时候启动你的机甲了。去哨站支援他们，你需要面对 2 只成虫。"
          ]
        },
        "dlg_node_041b933e_961f_4a36_a7cc_e2f60e384364": {
          "speaker": "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第3幕",
          "lines": [
            "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第3幕：有件事需要你帮忙。"
          ]
        },
        "dlg_node_f759bdc9_8447_4b6c_a9b3_4974bc620f16": {
          "speaker": "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第3幕",
          "lines": [
            "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第3幕：附近出现了 2 个敌人，逐个击败后再来找我交任务。"
          ]
        },
        "dlg_node_48ba7c51_b625_4e1a_995e_306d253a4493": {
          "speaker": "韩诺",
          "lines": [
            "该死…监测到不仅有虫族，还有人类的武装反应。是叛军！",
            "他们一定是趁着虫族攻击的机会渗透进来了，这些家伙比虫族更阴险狡猾。",
            "这次要面对 3 个敌人，可能有叛军潜入者混在虫群中。别让他们偷走我们的机密数据！"
          ]
        },
        "dlg_node_ff573cfe_6475_4350_9aa1_98c72a7f0592": {
          "speaker": "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第4幕",
          "lines": [
            "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第4幕：有件事需要你帮忙。"
          ]
        },
        "dlg_node_71274cb1_607b_46a8_8ecc_bb262793ffdc": {
          "speaker": "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第4幕",
          "lines": [
            "引导玩家称为机甲召唤师，中途遇袭，和叛军 · 第4幕：附近出现了 3 个敌人，逐个击败后再来找我交任务。"
          ]
        },
        "dlg_node_b577bb9d_5487_4bcb_af55_bb159a88f46e": {
          "speaker": "韩诺",
          "lines": [
            "难以置信，你竟然真的撑过来了。刚才那一战，你已经有了几分王牌机师的样子。",
            "从初次接触机甲，到现在直面叛军与虫群，你已经是合格的机甲召唤师了。",
            "不过这条防线还需要你，我们还有很多仗要打。欢迎正式加入，战友。"
          ]
        }
      },
      "choiceScripts": {
        "choice_node_b745d918_0c9c_42f3_88b0_45b7792e676e": {
          "title": "命运的抉择",
          "options": [
            {
              "id": "opt_f84a4455-e291-4c52-a693-252feab6f4eb",
              "text": "接受训练，成为召唤师！",
              "completesEvent": true
            },
            {
              "id": "opt_e9659d43-9839-41a9-821a-d6ac7366ad73",
              "text": "我需要考虑一下",
              "systemTip": "你暂时没有接受训练。做好准备后再来找韩诺吧。",
              "completesEvent": false,
              "forcedResult": "block"
