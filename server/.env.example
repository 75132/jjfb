# 复制为 server/.env 后按需填写。切勿提交真实凭据。
# ENVIRONMENT=development 时，未设置 MONGO_URL 默认连接本机；未设置 ENCRYPTION_KEY 会生成临时密钥。
# ENVIRONMENT=production 时，MONGO_URL 与 ENCRYPTION_KEY 均为必填，且禁止自动生成密钥。

ENVIRONMENT=development

WS_HOST=0.0.0.0
WS_PORT=8001

ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080

# development 可省略，默认 mongodb://127.0.0.1:27017/
# production 必须显式设置，例如：
# MONGO_URL=mongodb://USER:PASSWORD@127.0.0.1:27017/?authSource=admin
MONGO_URL=

# development 可省略（将生成临时密钥，重启后登录态可能失效）
# production 必须设置为足够长的固定随机串
ENCRYPTION_KEY=
