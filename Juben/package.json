{
  "name": "cocos-story-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n storage,web -c yellow,cyan \"npm run dev:storage\" \"wait-on http://localhost:8787/api/health && npm run dev:web\"",
    "dev:web": "vite",
    "dev:storage": "tsx watch server/index.ts",
    "dev:full": "npm run dev",
    "start:storage": "tsx server/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:map": "tsx scripts/export-story-project-map.ts",
    "export:test-base": "tsx scripts/export-story-project-map.ts ../assets/resources/Sample/剧情脚本/story_project_2026-06-27T22-15-16-272Z.json test_base",
    "publish:map": "tsx scripts/publish-runtime-map.ts",
    "align:maps": "tsx scripts/align-published-maps.ts",
    "audit:story-maps": "tsx scripts/audit-story-maps.ts",
    "sync:tilemap-coords": "tsx scripts/sync-tilemap-coords.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.2.1",
    "elkjs": "^0.11.1",
    "express": "^5.2.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.3",
    "wait-on": "^9.0.4"
  }
}
